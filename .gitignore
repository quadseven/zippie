# Secrets & local state
*.client.json
!configs/examples/**

# Android signing keys. NEVER in this repo - a signing key is a permanent app
# identity and a commit is forever. The gradle build refuses a keystore that
# resolves inside the checkout (companion-android/app/build.gradle.kts); this is
# the second lock on the same door.
*.jks
*.keystore
*.p12
/etc/
keys.json
wifi-secrets.json
!configs/examples/wifi-secrets.json
server.json
.private/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
dist/
build/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# WireGuard live confs
*.conf
!travel/gl-mt3000/**

# iOS companion. Paths lost their production/zippie/ prefix when zippie moved
# to its own repo (2026-08-06); without this block the 566 MB of Swift build
# output under ZippieCompanionKit/.build would be committable.
#
# The .xcodeproj is GENERATED by xcodegen from project.yml, and Info.plist is
# generated from that project's info: block - committing either creates a
# second source of truth that silently wins on the next open.
companion/*.xcodeproj/
companion/ZippieCompanionKit/.build/
companion/**/DerivedData/
companion/ZippieCompanionApp/Info.plist
# The gomobile xcframework: a ~23 MB built artifact, rebuilt by the mobile-bind
# CI job from travel/datapath-go/mobile.
companion/Frameworks/

# Android companion
companion-android/.gradle/
companion-android/app/build/
# Machine-specific SDK path; CI writes its own. Committing one would pin every
# checkout to a single developer's home directory.
companion-android/local.properties
*.iml

# Agent worktrees are local scratch, never part of a change.
.claude/worktrees/
