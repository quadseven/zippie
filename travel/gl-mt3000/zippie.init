#!/bin/sh /etc/rc.common
# OpenWrt procd unit for Zippie on GL.iNet / OpenWrt
START=99
STOP=10
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/zippie up --wifi-secrets /etc/zippie/wifi-secrets.json
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

# Killing the process is NOT a teardown.
#
# Without this, `/etc/init.d/zippie stop` left behind zippie's metric-1
# default route, the pb* WireGuard interfaces, AND the router's fail-closed
# policy rules -- which its VPN machinery arms when a wg interface appears and
# never disarms when one leaves. That last one blackholes `iif br-lan`, so the
# router itself keeps perfect connectivity while every client behind it is
# stranded, which is why it went unnoticed for hours on 2026-07-27.
#
# procd calls this before signalling the process, so `zippie down` still has
# a readable config and an intact interface list to work from.
stop_service() {
  # BOUNDED, BECAUSE THIS RUNS DURING SHUTDOWN (#175).
  #
  # `/etc/init.d/zippie enable` created K10zippie, so procd runs this on the way
  # down. On 2026-08-16 a graceful `reboot` never completed: the box was gone for
  # 76 minutes and needed a physical power cycle. /proc/uptime read 137 seconds
  # afterwards, so it never finished the shutdown at all.
  #
  # The hardware watchdog cannot save it. procd DELIBERATELY releases the
  # watchdog during shutdown so the box is not reset mid-flight - which means the
  # shutting-down window, the one that failed, is the only window with no safety
  # net.
  #
  # Which step hangs is still unknown, and the issue is honest that isolating it
  # costs a power cycle per attempt. It does not need to be known. `zippie down`
  # walks every tunnel with wg-quick, resolves the home endpoint for a host
  # route, and clears tables and firewall chains - each step bounded or cheap on
  # a healthy box, none of them bounded IN SUM, and all of them running while the
  # network is being dismantled underneath them. A ceiling makes the root cause
  # irrelevant to whether the router comes back.
  #
  # 25s is longer than a healthy teardown by a wide margin (measured at well
  # under a second) and far shorter than the 76-minute outage. If it expires, the
  # kill sweep below still runs and procd still proceeds.
  # NOT `timeout ... | logger`, and the reason is the bug Grug Elder caught in
  # the first version of this: `$?` after a PIPELINE is the exit status of the
  # LAST command, so it reports logger's success and the expiry branch can never
  # fire. A shutdown that hit the ceiling would have logged nothing and read
  # exactly like a clean one. The status is taken directly, with no pipe between
  # it and the test.
  #
  # ANY non-zero is treated as "did not finish cleanly". The first version tested
  # for 143 specifically, which is a second assumption - busybox and GNU timeout
  # do not agree on the code, and the distinction does not change what happens
  # next. Output is relayed to syslog afterwards, from a file, so logging can
  # never sit between the teardown and its own status again.
  _out=/tmp/zippie-stop.$$
  if timeout 25 /usr/bin/zippie down >"$_out" 2>&1; then
    logger -t zippie-stop "teardown finished cleanly"
  else
    logger -t zippie-stop "teardown did not finish cleanly (timeout or error) - shutdown continues"
  fi
  [ -s "$_out" ] && logger -t zippie-stop < "$_out"
  rm -f "$_out"

  # Sweep strays: a previous instance can outlive procd's supervision (seen
  # live 2026-07-30 - stop was a no-op on an orphaned agent, teardown then ran
  # UNDER it and clients went to 0bps). Bracket pattern avoids self-match.
  for p in $(ps w | grep "[p]ython3 -m zippie" | awk '{print $1}'); do
    kill "$p" 2>/dev/null
  done
  sleep 1
  for p in $(ps w | grep "[p]ython3 -m zippie" | awk '{print $1}'); do
    kill -9 "$p" 2>/dev/null && logger -t zippie-stop "SIGKILLed stray $p"
  done
}
